digraph "editor_conf"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="editor_conf",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Global editor state: cursor, viewport, file content, and window size."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" row",fontcolor="grey" ];
  Node2 [id="Node000002",label="rrow",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structrrow.html",tooltip="A single row of text stored as a UTF-8 byte buffer."];
}
